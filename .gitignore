# ─── Secretos (REGLA OBLIGATORIA: nunca subir claves) ───
.env
.env.*
!.env.example
*.pem
*.key

# ─── Python ───
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# ─── Datos crudos: se regeneran con el recolector, no se versionan ───
# (los procesados en data/processed/ sí se versionan: son la "base de datos" de la v1)
data/raw/

# ─── Angular / Node (fase 2) ───
node_modules/
web/dist/
web/.angular/
# Copia de data/processed/ que hace web/scripts/copiar-datos.mjs en cada build
web/public/data/
# Configuración local de Vercel CLI (puede contener IDs del proyecto)
.vercel/

# ─── Configuración local de Claude Code (permisos de esta máquina) ───
.claude/settings.local.json

# ─── Sistema operativo / editores ───
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
